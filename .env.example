# ===== AlvoPrompter — variáveis de ambiente (opcionais) =====
# Copie para .env.local e preencha apenas o que for usar.
# O núcleo local funciona sem rede. Login usa a configuração pública padrão de alvoprompt.

# --- Cloudflare (IA, transcrição Whisper, TTS/dublagem e sync) ---
# Veja README: /functions/cloudflare e o Worker em api/transcribe
# A API base padrão já aponta para o Worker publicado. Para usar o Worker local,
# defina VITE_CLOUDFLARE_API_BASE=http://localhost:8787 em .env.local.
# O sync usa /account/workspaces/:id/content com autenticação e permissões.
VITE_CLOUDFLARE_API_BASE=

# --- Firebase Authentication (valores públicos do app Web) ---
# Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Meta Ads (ID público; não é uma chave secreta) ---
# Deve ser o mesmo ID numérico configurado em landing/index.html.
# O Pixel só carrega depois do consentimento explícito do visitante.
VITE_META_PIXEL_ID=

# A chave do provedor de IA nunca deve usar o prefixo VITE_. Configure-a somente no Worker:
# --- Pexels Video API (B-roll) ---
# Chave gratuita em https://www.pexels.com/api/ — habilita a busca de clipes de fundo (B-roll).
# Sem a chave, o B-roll ainda funciona por upload ou URL de vídeo.
VITE_PEXELS_API_KEY=

# A chave do Carcará nunca deve usar o prefixo VITE_. Configure-a somente no Worker:
# cd api/transcribe && npx wrangler secret put CARCARA_API_KEY

# --- Segredos do Worker para contas e cobrança ---
# Nunca use prefixo VITE_ nestas variáveis:
# cd api/transcribe
# npx wrangler secret put ASAAS_API_KEY
# npx wrangler secret put ASAAS_WEBHOOK_TOKEN
# O FIREBASE_PROJECT_ID, APP_URL e ASAAS_API_BASE ficam em api/transcribe/wrangler.toml.

# --- Login social (habilitar somente após configurar e validar os provedores) ---
# Google web já está ativo no Firebase; autorize também o domínio de produção.
VITE_AUTH_GOOGLE_ENABLED=true
# Apple exige Service ID/Team ID/chave no Firebase e capability no iOS.
VITE_AUTH_APPLE_ENABLED=false
# Veja docs/entrega/login-social.md para a preparação Android/iOS.
